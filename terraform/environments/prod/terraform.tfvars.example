# Copy to terraform.tfvars only for local use; never commit secrets.
project = "eks-platform"
admin_role_arns = ["arn:aws:iam::001495086648:role/AutomationAdminAll"]
github_oidc_subjects = ["repo:vipinkumar1234@110930371/aws-eks-production-platform@1359084778:environment:prod"]
owner = "vipin"
cost_center = "gaming-test"
# Discover and test the regional AL2023 x86_64 EKS 1.34 AMI before pinning.
karpenter_ami_id = "ami-REPLACE_WITH_TESTED_REGIONAL_ID"
# GitHub OIDC must already exist for the initial deployment role to authenticate.
github_oidc_provider_arn = "arn:aws:iam::001495086648:oidc-provider/token.actions.githubusercontent.com"
